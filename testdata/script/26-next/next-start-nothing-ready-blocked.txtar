# with --start nothing is claimed and the blocked count is still said
env TODO_FILE=$WORK/todo.txt
env LSTY_OWNER=agent1
exec lsty next --start --filter +a --no-config
cmp stdout want
exec lsty next --start --filter +a --json --no-config
stdout '"later_count":0,"blocked_count":1,"claimed_count":0,"resumed":false,"messages":\["nothing ready \(1 blocked\)"\]'
cmp todo.txt want-todo

-- todo.txt --
Waits +a dep:b
Other +b id:b
-- want-todo --
Waits +a dep:b
Other +b id:b
-- want --
nothing ready (1 blocked)
