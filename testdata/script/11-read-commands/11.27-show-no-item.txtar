env TODO_FILE=$WORK/todo.txt
exit 3 lsty show 3 --no-config
stderr '^lsty: no item 3$'
! stdout .

exit 3 lsty show 9 --no-config
stderr '^lsty: no item 9$'

exit 3 lsty show done:5 --json --no-config
cmpjson stdout want

