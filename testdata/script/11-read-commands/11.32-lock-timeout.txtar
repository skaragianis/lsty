[!exec:flock] skip 'needs flock'
env TODO_FILE=$WORK/todo.txt
env LSTY_CONFIG=$WORK/config.toml
exec flock $WORK sleep 1.2 &
exec sleep 0.5
exit 4 lsty ls --json
stdout '"code":"lock_timeout"'
wait

