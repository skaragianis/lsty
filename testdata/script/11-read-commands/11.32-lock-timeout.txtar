[!exec:flock] skip 'needs flock'
env TODO_FILE=$WORK/todo.txt
exec flock $WORK sleep 3 &
exec sleep 0.5
exit 4 lsty ls --json --no-config
stdout '"code":"lock_timeout"'
wait

