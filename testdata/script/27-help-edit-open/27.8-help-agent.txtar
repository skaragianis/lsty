exec lsty help --agent
! stderr .
stdout '(?s)# Identity.*# Calls.*# Getting work.*# Files.*# Queries.*# Adding.*# Dates.*# Claims.*# Retries.*# Exit codes'
stdout 'LSTY_OWNER'
stdout '`add --if-absent TEXT`'
stdout 'lsty gives agents their ids;'
stdout '\(--print-id prints only the id; next --start'
stdout '`wait IDS…` returns when one of the tasks changes, or at once if one is done'
stdout 'Check them with `lsty show` before acting\.'
stdout 'found_by'
stdout 'next --start'
stdout '(?m)^todo file''s folder \(file:\.\./notes/plan\.md\); ~ is home\.$'
stdout '(?m)^  add, addm: —; repeats; no-op with --if-absent \(by text on the same day\)$'
stdout '(?m)^  id: NR \+ --expect, or id:; no-op; by NR after the lines shifted: detected$'
stdout '(?m)^  pri, depri, untag, del REF TERM, do, reopen, start, stop: id:; no-op$'
stdout '(?m)^  tag: id:; no-op \(due:/t: values: same day\)$'
! stdout '.{81}'
! stdout '(?s)^(?:[^\n]*\n){71}'
