exec lsty help keys
! stderr .
stdout '^lsty help keys: actions and default keys\n'
stdout 'the same for everyone'
stdout '(?m)^Modes: normal visual insert completion command panel detail help picker$'
stdout '(?s)\nnormal\n  Navigation\n    cursor_down +j, <Down> +Move the cursor down\n'
stdout '(?m)^    toggle_complete +x, <Space> +Complete or reopen a task$'
stdout '(?m)^picker$'
stdout '(?m)^config.toml:$'
stdout '(?m)^  \[hints\]$'
! stdout '.{81}'

exec lsty help KEYS
stdout '(?m)^picker$'

exec lsty help
stdout '(?m)^       lsty help keys +the actions and keys of keys.toml$'

exit 2 lsty help keys extra
! stdout .
stderr 'unknown command "extra"'
