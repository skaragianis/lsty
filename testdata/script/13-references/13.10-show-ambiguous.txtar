env TODO_FILE=$WORK/todo.txt
exit 3 lsty show id:k --json --no-config
cmpjson stdout want

-- todo.txt --
A id:k
B id:k
-- want --
{"version": 2, "file": "$WORK/todo.txt", "done_file": "$WORK/done.txt", "today": "2026-09-29",
 "error": {"code": "ambiguous", "exit": 3, "message": "id:k is on 2 lines", "hint": null,
  "id": "k", "refs": [{"nr": 1, "source": "todo", "id": "k"}, {"nr": 2, "source": "todo", "id": "k"}]}}
