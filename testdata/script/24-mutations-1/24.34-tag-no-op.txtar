env TODO_FILE=$WORK/todo.txt
env LSTY_OWNER=agent1
exec lsty tag id:k3f9 +work due:fri --no-config
cmp stdout out1
cp todo.txt after1
exec lsty tag id:k3f9 +work due:fri --no-config
cmp stdout out2
cp todo.txt after2
cmp after1 want1
cmp after2 want2

-- todo.txt --
Call client +work
Add CLI ls +spec02 id:k3f9
Write docs
-- want1 --
Call client +work
Add CLI ls +spec02 id:k3f9 +work due:2026-10-02
Write docs
-- want2 --
Call client +work
Add CLI ls +spec02 id:k3f9 +work due:2026-10-02
Write docs
-- out1 --
k3f9 tagged +work
k3f9 tagged due:2026-10-02
-- out2 --
k3f9 already has +work
k3f9 already has due:2026-10-02
