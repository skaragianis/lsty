env TODO_FILE=$WORK/todo.txt
exec lsty add N --after 1 --human --json --no-config
stdout '"renumbered":true'
stdout '"tasks":\[\{"nr":2,'
match todo.txt want

-- todo.txt --
Call client +work
Add CLI ls +spec02 id:k3f9
Write docs
-- want --
Call client +work
2026-09-29 N id:<id1>
Add CLI ls +spec02 id:k3f9
Write docs
