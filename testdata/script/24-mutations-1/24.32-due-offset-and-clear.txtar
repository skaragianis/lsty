env TODO_FILE=$WORK/todo.txt
exec lsty due id:k3f9 --owner agent1 --no-config -- -3d
cmp stdout out1
cmp todo.txt want1
exec lsty due 1 '' --human --no-config
cmp stdout out2
cmp todo.txt want2

