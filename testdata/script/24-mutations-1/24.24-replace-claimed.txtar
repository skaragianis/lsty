env TODO_FILE=$WORK/todo.txt
env LSTY_OWNER=agent1
cp todo.txt before
exit 3 lsty replace id:k3f9 'Ring client' --json --no-config
cmpjson stdout want
cmp todo.txt before
exit 0 lsty replace id:k3f9 'Ring client' --takeover --no-config
cmp todo.txt after

-- todo.txt --
Call client
Add CLI ls started:2026-09-28T0900Z owner:agent2 id:k3f9
-- want --
{"version": 1, "file": "$WORK/todo.txt", "done_file": "$WORK/done.txt", "today": "2026-09-29",
 "error": {"code": "claimed", "exit": 3, "message": "k3f9 is claimed by agent2 since 2026-09-28T09:00Z", "hint": "pick another item with lsty next; pass --takeover only when told to", "nr": 2, "source": "todo", "id": "k3f9", "owner": "agent2", "started": "2026-09-28T09:00:00Z"}}
-- after --
Call client
Ring client started:2026-09-28T0900Z owner:agent2 id:k3f9
