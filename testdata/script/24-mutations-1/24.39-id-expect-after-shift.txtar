env TODO_FILE=$WORK/todo.txt
env LSTY_OWNER=agent1
exec lsty add 'New first' --top --no-config
exit 3 lsty id 2 --expect 'Add CLI ls' --json --no-config
stdout '"code":"expect_mismatch"'
cmpjson stdout want

-- todo.txt --
Call client +work
Add CLI ls +spec02 id:k3f9
Write docs
-- want --
{"version": 2, "file": "$WORK/todo.txt", "done_file": "$WORK/done.txt", "today": "2026-09-29",
 "error": {"code": "expect_mismatch", "exit": 3, "message": "item 2 is \"Call client\", expected \"Add CLI ls\"", "hint": null, "nr": 2, "source": "todo", "id": null, "actual": "Call client", "expected": "Add CLI ls"}}
