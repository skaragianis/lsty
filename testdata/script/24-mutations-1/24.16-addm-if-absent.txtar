env TODO_FILE=$WORK/todo.txt
[!exec:sh] skip 'needs sh'
exec sh -c 'lsty addm --if-absent "$(printf "A id:a\nB id:b")" --human --no-config'
cp todo.txt after1
exec sh -c 'lsty addm --if-absent "$(printf "A id:a\nB id:b")" --human --no-config'
cp todo.txt after2
cmp after1 want
cmp after2 want

-- todo.txt --
-- want --
2026-09-29 A id:a
2026-09-29 B id:b
