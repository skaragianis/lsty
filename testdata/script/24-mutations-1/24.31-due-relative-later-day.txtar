env TODO_FILE=$WORK/todo.txt
env LSTY_OWNER=agent1
exec lsty due id:k3f9 fri --no-config
cp todo.txt after1
env LSTY_NOW=2026-10-03T0900Z
exec lsty due id:k3f9 fri --no-config
cmp stdout out2
cp todo.txt after2
cmp after1 want1
cmp after2 want2

-- todo.txt --
Call client +work
Add CLI ls +spec02 id:k3f9
Write docs
-- want1 --
Call client +work
Add CLI ls +spec02 id:k3f9 due:2026-10-02
Write docs
-- want2 --
Call client +work
Add CLI ls +spec02 id:k3f9 due:2026-10-09
Write docs
-- out2 --
k3f9 due 2026-10-09
