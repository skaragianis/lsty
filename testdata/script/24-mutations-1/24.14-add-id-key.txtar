env TODO_FILE=$WORK/todo.txt
exec lsty add 'Write parser' --if-absent --id=parser --human --no-config
cp todo.txt after1
exec lsty replace id:parser 'Write the parser' --human --no-config
cp todo.txt after2
exec lsty add 'Write parser' --if-absent --id=parser --human --no-config
cp todo.txt after3
cmp after1 want1
cmp after2 want2
cmp after3 want2

-- todo.txt --
-- want1 --
2026-09-29 Write parser id:parser
-- want2 --
2026-09-29 Write the parser id:parser
