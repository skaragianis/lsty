env TODO_FILE=$WORK/todo.txt
env LSTY_OWNER=agent1
exec lsty add Buy milk --if-absent --no-config
cp todo.txt after1
exec lsty add Buy milk --if-absent --json --no-config
cp todo.txt after2
cmpjson stdout want
match after1 want1
match after2 want1

-- todo.txt --
Call client +work
Add CLI ls +spec02 id:k3f9
Write docs
-- want1 --
Call client +work
Add CLI ls +spec02 id:k3f9
Write docs
2026-09-29 Buy milk id:<id1>
