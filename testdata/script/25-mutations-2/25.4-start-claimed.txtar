env TODO_FILE=$WORK/todo.txt
env LSTY_OWNER=agent1
exec lsty start id:c1 --no-config
env LSTY_OWNER=agent2
cp todo.txt before
exit 3 lsty start id:c1 --json --no-config
stdout '"code":"claimed"'
stdout '"owner":"agent1"'
cmp todo.txt before
exec lsty start id:c1 --takeover --no-config
cmp stdout out
cmp todo.txt want

