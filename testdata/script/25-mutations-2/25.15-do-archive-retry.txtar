env TODO_FILE=$WORK/todo.txt
env LSTY_OWNER=agent1
exec lsty start id:c1 --no-config
exec lsty do id:c1 --archive --json --no-config
stdout '"tasks":\[\{"nr":1,"source":"done"'
cmp todo.txt want
cmp done.txt wantdone
cp todo.txt after1
exec lsty do id:c1 --archive --no-config
cmp stdout out
cmp todo.txt after1
cmp done.txt wantdone

-- todo.txt --
(A) Write parser +spec01 id:parser
(A) Add CLI ls +spec02 id:k3f9 dep:parser
Call client +work id:c1
Pay rent rec:1m due:2026-09-30 id:r1
-- want --
(A) Write parser +spec01 id:parser
(A) Add CLI ls +spec02 id:k3f9 dep:parser

Pay rent rec:1m due:2026-09-30 id:r1
-- wantdone --
x 2026-09-29 Call client +work id:c1 started:2026-09-29T0900Z owner:agent1 ended:2026-09-29T0900Z
-- out --
c1 is already done
