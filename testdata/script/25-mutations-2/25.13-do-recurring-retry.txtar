env TODO_FILE=$WORK/todo.txt
env LSTY_OWNER=agent1
exec lsty start id:r1 --no-config
exec lsty do id:r1 --json --no-config
stdout '"renumbered":false'
stdout '"spawned":\[\{[^{}]*"due":"2026-10-29"[^{}]*\}\],"changed"'
cmp todo.txt want1
exec lsty do id:r1 --no-config
cmp todo.txt want1

