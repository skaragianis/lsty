env TODO_FILE=$WORK/todo.txt
env LSTY_OWNER=agent1
exec lsty undep id:k3f9 on id:parser --no-config
cmp stdout out1
cp todo.txt after1
exec lsty undep id:k3f9 on id:parser --no-config
cmp stdout out2
cmp todo.txt after1
cmp todo.txt want

