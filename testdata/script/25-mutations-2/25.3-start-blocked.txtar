env TODO_FILE=$WORK/todo.txt
env LSTY_OWNER=agent1
cp todo.txt before
exit 3 lsty start id:k3f9 --json --no-config
stdout '"code":"blocked"'
stdout '"blockers":\[\{"nr":1,"source":"todo","id":"parser"\}\]'
cmp todo.txt before
exec lsty start id:k3f9 --ignore-blocked --no-config
cmp todo.txt want

