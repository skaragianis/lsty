env TODO_FILE=$WORK/todo.txt
env LSTY_OWNER=agent1
exec lsty archive --no-config
exec lsty restore id:c1 --no-config
cmp todo.txt want
cp todo.txt after1
exec lsty restore id:c1 --no-config
cmp stdout out
cmp todo.txt after1

