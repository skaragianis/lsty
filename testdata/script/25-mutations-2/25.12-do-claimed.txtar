env TODO_FILE=$WORK/todo.txt
env LSTY_OWNER=agent1
env LSTY_OWNER=agent2
cp todo.txt before
exit 3 lsty do id:c1 --json --no-config
stdout '"code":"claimed"'
cmp todo.txt before
exec lsty do id:c1 --takeover --no-config
cmp todo.txt want

