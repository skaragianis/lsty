# At 16 colours a built-in theme draws in the terminal's own colours.
env TERM=xterm
env COLORTERM=
mkdir home/.config/lsty
cp config.toml home/.config/lsty/config.toml
mkdir .git
exec lsty lsa --color=always
cmp stdout want

-- config.toml --
theme = "tokyo-night-storm"
-- todo.txt --
(A) Call +work @phone
x 2026-09-28 Fix bug +work due:2026-09-20
-- done.txt --
x 2026-09-01 Old task +work
