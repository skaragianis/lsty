start
keys ?
keys j j j j j j j j j j
frame down
keys <C-d>
frame half
keys <C-u>
frame back
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
(A) Call client +work
Buy milk +home
Done item

