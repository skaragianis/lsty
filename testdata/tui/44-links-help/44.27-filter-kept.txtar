start
keys ?
keys /
type undo
keys <CR>
frame kept
keys /
keys <C-u>
keys <CR>
frame all
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
(A) Call client +work
Buy milk +home
Done item

