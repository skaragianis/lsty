size 60 10
start
keys ?
keys <C-f>
frame page-down
keys <C-e>
frame one-row-down
keys zz zt zb H M L
frame cursorless-keys-do-nothing
keys <C-b>
frame page-up
keys <C-y>
frame one-row-up
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
Buy milk
