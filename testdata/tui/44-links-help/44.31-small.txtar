start
keys ?
keys <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d> <C-d>
frame end
-- config.toml --
show_sidebar = false
show_detail = false
