start
keys ?
write todo.txt after
tick 100ms
frame open
keys q
frame closed
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
(A) Call client +work
Buy milk +home
Done item

-- after --
(A) Call client +work
Buy milk +home
Done item
Fresh row
