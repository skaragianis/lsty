size 100 14
start
keys G a
type ␣+ork
frame a-frame
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
Write parser +spec01 id:parser
Call client
-- done.txt --
x 2026-09-02 Send report +work @email
x 2026-09-03 Pitch +work.acme
x 2026-09-04 Plan +elsewhere
