size 100 14
start
keys G a
type ␣dep:docs
keys <Tab>
write todo.txt other
tick 1s
frame before
keys <CR>
frame after
file todo.txt result
keys <C-w>
type dep:docs
keys <Tab>
keys <CR>
file todo.txt repicked
-- config.toml --
show_sidebar = false
show_detail = false
