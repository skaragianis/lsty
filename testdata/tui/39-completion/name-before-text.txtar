size 80 10
start
keys G a
type ␣call␣bob
keys <Left> <Left> <Left>
type +
frame popup
keys <Tab>
frame accepted
keys <CR>
file todo.txt saved
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
Ask about lunch +rooms
Book a room +people
Call back
-- saved --
Ask about lunch +rooms
Book a room +people
Call back call +people bob
