size 100 14
start
keys G a
type ␣dep:docs
keys <Tab>
write todo.txt other
keys <CR>
frame after
file todo.txt result
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
Write parser +spec01 id:parser
Write docs +spec01
Call client
-- other --
Write parser +spec01 id:parser
Write docs +spec01
Call client id:t001
-- after --
