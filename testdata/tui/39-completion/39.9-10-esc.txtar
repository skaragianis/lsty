size 100 14
start
keys G a
type ␣+w
keys <Esc>
frame a-frame
cursor a-cursor
keys <Esc>
frame b-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
Write parser +spec01 id:parser
Add CLI ls +spec01 dep:parser
Write docs +spec01
Write docs +spec02 due:2026-10-02
Call client
