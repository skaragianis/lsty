size 100 14
start
keys G a
type ␣+
frame a-frame
bg a-bg
type w
frame b-frame
keys <Tab>
frame c-frame
cursor c-cursor
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
Write parser +spec01 id:parser
Add CLI ls +spec01 dep:parser
Write docs +spec01
Write docs +spec02 due:2026-10-02
Call client
-- done.txt --
x 2026-09-01 Fix tap +home @phone
x 2026-09-02 Send report +work @email
x 2026-09-03 Pitch +work.acme
