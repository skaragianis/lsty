size 100 14
start
keys G a
type ␣+w
keys j <Tab>
type ␣x
keys <CR>
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- keys.toml --
[insert]
commit = ["jk", "<CR>"]
-- todo.txt --
Write parser +spec01 id:parser
Call client
-- done.txt --
x 2026-09-03 Pitch +work.acme
-- a-file --
Write parser +spec01 id:parser
Call client +work.acme x
