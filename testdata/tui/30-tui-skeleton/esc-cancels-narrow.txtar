size 40 5
start
keys /A<CR>
frame search
keys g
frame pending
keys <Esc>2
frame count
keys <Esc><Esc>vj3
frame visual
keys <Esc>g
frame visual-pending
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
Also A
