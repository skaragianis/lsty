size 100 6
start
frame no-tasks
fg no-tasks-colour
keys 2
fg a-count-colour
keys <Esc>
keys x
frame x-says-nothing
keys /Zzz<CR>
fg no-hit-colour
-- config.toml --
show_sidebar = false
show_detail = false
