size 60 8
start
frame shown
keys :
type set noshow_ids
keys <CR>
frame hidden
keys :
type set show_ids
keys <CR>
frame shown-again
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
Write parser id:p +work
Add CLI dep:p +work
Buy milk
