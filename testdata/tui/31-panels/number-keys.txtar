size 80 14
start
keys <C-w>3
fg contexts
keys <C-w>4
fg filters
keys <C-w>2
fg projects
keys <C-w>1
fg list
frame list-frame
-- config.toml --
show_detail = false
-- todo.txt --
A +work @phone
B +home
