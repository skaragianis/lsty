size 130 14
start
keys <C-w>2
frame by-number
keys <Esc>
frame back-esc
keys <C-w>l
frame by-right
keys <C-w>h
frame back-left
click 120 3
frame by-click
keys <C-w>1
frame back-number
-- config.toml --
show_sidebar = false
-- todo.txt --
Read docs file:docs/a.md file:docs/b.md
Second
-- docs/a.md --
a
-- docs/b.md --
b
