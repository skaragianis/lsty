size 130 20
start
clickon "Fix tap"
keys j
frame clicked
keys <C-w>j
frame detail-focus
keys <C-w>k
keys <C-w>j
frame down-to-detail
keys <C-w>k
frame up-to-list
clickon "state"
frame clicked-detail
-- todo.txt --
(A) Call client +work @phone due:2026-09-30
Buy milk +home
Fix tap +home
-- config.toml --
detail_position = "bottom"
