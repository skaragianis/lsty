size 140 10
start
keys c c
type Ring client
write todo.txt disk
keys <CR>
keys <C-x>
file todo.txt a-file
keys u
frame a-frame
cursor a-cursor
-- config.toml --
show_sidebar = false
show_detail = false
-- keys.toml --
[insert]
cancel = ["<C-x>"]
-- todo.txt --
(A) 2026-09-20 Call client +work id:c1
