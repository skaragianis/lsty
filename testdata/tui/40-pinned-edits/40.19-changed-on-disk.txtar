size 100 10
start
keys a
type ␣!
write todo.txt disk
tick 1s
frame a-frame
cursor a-cursor
keys <CR>
frame b-frame
keys <Esc>
frame c-frame
file todo.txt c-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
(A) 2026-09-20 Call client +work id:c1
