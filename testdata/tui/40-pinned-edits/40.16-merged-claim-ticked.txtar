size 100 10
start
keys c c
type Ring client
write todo.txt disk
tick 1s
frame a-frame
keys <CR>
frame b-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
(A) 2026-09-20 Call client +work id:c1
-- disk --
New
(A) 2026-09-20 Call client +work id:c1 started:2026-09-29T0900Z owner:agent1
