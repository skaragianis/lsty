size 140 10
start
keys c c
type Ring client
write todo.txt disk
keys <CR>
write todo.txt again
keys <CR>
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
