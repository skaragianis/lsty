size 100 10
start
keys c c
type Ring client
write todo.txt disk
keys <CR>
write todo.txt outside
keys u
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
(A) 2026-09-20 Call client +work id:c1
Other
