size 70 8
start
keys x
write todo.txt next
keys u
frame after
file todo.txt after-todo
file done.txt after-done
-- config.toml --
show_sidebar = false
show_detail = false
auto_archive = true
-- todo.txt --
A
B
-- done.txt --
-- next --

B +t
-- after --
┌ [1]─~/todo.txt ────────────────────────────────────────────────────┐
│  1   A                                                             │
│  1   B +t                                                          │
│                                                                    │
│                                                                    │
│                                                                    │
└────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  undid: 1 done: A  x done  t state    9.9.9
-- after-todo --
A
B +t
-- after-done --
