size 70 8
start
keys x
frame archived
file todo.txt archived-todo
file done.txt archived-done
keys u
frame after
file todo.txt after-todo
file done.txt after-done
-- config.toml --
show_sidebar = false
show_detail = false
auto_archive = true
-- todo.txt --
A
B
-- done.txt --
-- archived --
┌ [1]─~/todo.txt ────────────────────────────────────────────────────┐
│    ✓     A                                                filtered │
│  2       B                                                         │
│                                                                    │
│                                                                    │
│                                                                    │
└────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  1 done: A; archived to done.txt as done:1;
-- archived-todo --

B
-- archived-done --
x 2026-09-29 A
-- after --
┌ [1]─~/todo.txt ────────────────────────────────────────────────────┐
│  1       A                                                         │
│  1       B                                                         │
│                                                                    │
│                                                                    │
│                                                                    │
└────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  undid: 1 done: A  x done  t state  o new
-- after-todo --
A
B
-- after-done --
