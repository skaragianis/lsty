size 70 8
start
keys x
keys u
frame undone
file todo.txt undone-todo
keys <C-r>
frame redone
file todo.txt redone-todo
keys u
frame undone-again
file todo.txt undone-again-todo
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
Buy
-- undone --
┌ [1]─~/todo.txt ────────────────────────────────────────────────────┐
│  1   Buy                                                           │
│                                                                    │
│                                                                    │
│                                                                    │
│                                                                    │
└────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  undid: 1 done: Buy  x done  t state  T stop
-- undone-todo --
Buy
-- redone --
┌ [1]─~/todo.txt ────────────────────────────────────────────────────┐
│  1 ✓ Buy                                                           │
│                                                                    │
│                                                                    │
│                                                                    │
│                                                                    │
└────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  redid: 1 done: Buy  x done  t state  T stop
-- redone-todo --
x 2026-09-29 Buy
