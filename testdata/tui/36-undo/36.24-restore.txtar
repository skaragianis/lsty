size 70 8
start
keys j x
frame restored
file todo.txt restored-todo
file done.txt restored-done
keys u
frame after
file todo.txt after-todo
file done.txt after-done
-- config.toml --
show_sidebar = false
show_detail = false
hidden_tasks = ["later"]
