size 70 8
start
keys j d d
frame deleted
file todo.txt deleted-todo
write todo.txt next
keys u
frame after
file todo.txt after-todo
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B
C
-- next --
A
C
