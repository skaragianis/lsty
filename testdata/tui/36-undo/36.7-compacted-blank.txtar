size 70 8
start
keys j d d
frame deleted
file todo.txt deleted-todo
write todo.txt next
keys u
frame after
file todo.txt after-todo
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B
C
-- next --
A
C
-- deleted --
┌ [1]─~/todo.txt ────────────────────────────────────────────────────┐
│  1   A                                                             │
│  3   C                                                             │
│                                                                    │
│                                                                    │
│                                                                    │
└────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  2 deleted  x done  t state  o new  a append
-- deleted-todo --
A

C
-- after --
┌ [1]─~/todo.txt ────────────────────────────────────────────────────┐
│  1   A                                                             │
│  2   B                                                             │
│  1   C                                                             │
│                                                                    │
│                                                                    │
└────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  undid: 2 deleted  x done  t state  o new
-- after-todo --
A
B
C
