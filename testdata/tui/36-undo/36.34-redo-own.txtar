size 70 8
start
keys x
keys u
write todo.txt next
keys <C-r>
frame refused
file todo.txt refused-todo
keys <C-r>
frame dropped
file todo.txt dropped-todo
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
Buy
-- next --
Buy +t
-- refused --
┌[1]─"~/todo.txt"────────────────────────────────────────────────────┐
│  1   Buy +t                                                        │
│                                                                    │
│                                                                    │
│                                                                    │
│                                                                    │
└────────────────────────────────────────────────────────────────────┘
 N  can't redo: the list changed — look again  sort(manual)      1|1
-- refused-todo --
Buy +t
-- dropped --
┌[1]─"~/todo.txt"────────────────────────────────────────────────────┐
│  1   Buy +t                                                        │
│                                                                    │
│                                                                    │
│                                                                    │
│                                                                    │
└────────────────────────────────────────────────────────────────────┘
 N  nothing to redo  sort(manual)  x done  t start         1|1  9.9.9
-- dropped-todo --
Buy +t
