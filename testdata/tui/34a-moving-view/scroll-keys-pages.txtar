size 60 10
start
keys <C-f>
frame page-down
keys <C-f>
frame page-down-again
keys 2<C-b>
frame two-pages-up
keys <C-b>
frame page-up-at-top
keys G <C-f>
frame page-down-at-bottom
-- config.toml --
show_sidebar = false
show_detail = false
