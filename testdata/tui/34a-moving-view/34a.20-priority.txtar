size 100 8
start
keys g p
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
start_filter = "Top"

[filters]
Top = "pri:A"
-- todo.txt --
(A) X
(A) Y
-- a-frame --
┌[1]─Top───────────────────────────────────────────────────────────────────────────────────────────┐
│  1       X                                                                              filtered │
│  1   (A) Y                                                                                       │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 N  sort(manual)  1 deprioritized; hidden by current filters in 2 seconds or at the next key   1|2
-- a-file --
X
(A) Y
