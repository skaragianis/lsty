size 100 8
start
keys x
frame a-frame
fg a-fg
file todo.txt a-file
keys j
frame b-frame
-- config.toml --
show_sidebar = false
show_detail = false
hidden_tasks = ["later", "archive", "done"]
-- todo.txt --
A
B
C
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1 ✓ A                                                                                  filtered │
│  2   B                                                                                           │
│  1   C                                                                                           │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  1 done: A; hidden by current filters in 2 seconds or at the next key
-- a-file --
x 2026-09-29 A
B
C
-- b-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   B                                                                                           │
│  3   C                                                                                           │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
