size 100 8
start
keys x
frame a-frame
fg a-fg
file todo.txt a-file
keys j
frame b-frame
-- config.toml --
show_sidebar = false
show_detail = false
hidden_items = ["later", "archive", "done"]
-- todo.txt --
A
B
C
