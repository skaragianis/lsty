size 100 8
start
keys x
frame a-frame
fg a-fg
file todo.txt a-file
keys j
frame b-frame
keys G x v k
frame c-frame
keys j K
frame d-frame
-- config.toml --
show_sidebar = false
show_detail = false
hidden_tasks = ["later", "archive", "done"]
-- todo.txt --
A
B
C
