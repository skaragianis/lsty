size 100 8
start
keys x x
write todo.txt next
tick 50ms
frame a-frame
-- config.toml --
show_sidebar = false
show_detail = false
hidden_items = ["later", "archive", "done"]
-- todo.txt --
A
B
C
-- next --
x 2026-09-29 A
B
C
