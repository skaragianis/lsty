size 80 5
start
keys <C-w>4 99<C-e> 99<C-y> zz zt zb H M L
keys <Esc> 99<C-e> 99<C-y> zz zt zb H M L <C-f> <C-b>
frame still-here
-- config.toml --
show_sidebar = true
show_detail = false
-- todo.txt --
a01 +p01 @c01
a02 +p02 @c02
-- still-here --
┌[3]─Projects─┐┌ [1]─~/todo.txt ───────────────────────────────────────────────┐
├[4]─Contexts─┤│  1       a01                                        +p01 @c01 │
├[5]─Filters──┤│  1       a02                                        +p02 @c02 │
└─────────────┘└───────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  x done  t state  o new  a append  dd delete  u undo
