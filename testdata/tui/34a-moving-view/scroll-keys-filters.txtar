size 80 24
start
keys <C-w>5 L
frame view-bottom
bg view-bottom-bg
keys gg 2L
frame second-from-bottom
bg second-from-bottom-bg
keys gg 9<C-e>
frame scroll-to-the-end
bg scroll-to-the-end-bg
keys G <C-y>
frame scroll-back
bg scroll-back-bg
keys gg <C-f>
frame page-across-the-rule
bg page-across-the-rule-bg
keys M
frame middle
bg middle-bg
keys zz
frame centre
bg centre-bg
keys zt
frame top
bg top-bg
keys zb
frame bottom-row
bg bottom-row-bg
keys gg 3H
frame third-from-top
bg third-from-top-bg
-- config.toml --
show_sidebar = true
show_detail = false
-- todo.txt --
a01 +p01 @c01
a02 +p02 @c02
