size 100 8
start
lock hold
keys J
frame a-frame
file todo.txt a-file
lock release
keys J
frame b-frame
file todo.txt b-file
-- config.toml --
show_sidebar = false
show_detail = false
lock_timeout = "50ms"
-- todo.txt --
A
B
C
-- a-frame --
┌ [1]─todo.txt ────────────────────────────────────────────────────────────────────────────────────┐
│  1       A                                                                                       │
│  1       B                                                                                       │
│  2       C                                                                                       │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  todo.txt is busy (locked by another writer) — nothing changed, try again
-- a-file --
A
B
C
-- b-frame --
┌ [1]─todo.txt ────────────────────────────────────────────────────────────────────────────────────┐
│  1       B                                                                                       │
│  2       A                                                                                       │
│  1       C                                                                                       │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  1 moved to 2  x done  t state  o new  a append  dd delete  u undo
-- b-file --
B
A
C
