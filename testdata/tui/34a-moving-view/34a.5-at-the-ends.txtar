size 100 8
start
keys G J
frame a-frame
file todo.txt a-file
keys g g K
frame b-frame
file todo.txt b-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B
C
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  2   A                                                                                           │
│  1   B                                                                                           │
│  3   C                                                                                           │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  x done  t state  o new  a append  dd delete  u undo  / search  ? help
-- a-file --
A
B
C
-- b-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   A                                                                                           │
│  1   B                                                                                           │
│  2   C                                                                                           │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  x done  t state  o new  a append  dd delete  u undo  / search  ? help
