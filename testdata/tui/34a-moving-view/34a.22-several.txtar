size 100 8
start
keys 2 x
frame a-frame
file todo.txt a-file
keys j
frame b-frame
keys j
frame c-frame
-- config.toml --
show_sidebar = false
show_detail = false
hidden_tasks = ["later", "archive", "done"]
-- todo.txt --
A
B
C
D
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  2 ✓ A                                                                                  filtered │
│  1 ✓ B                                                                                  filtered │
│  3   C                                                                                           │
│  1   D                                                                                           │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  1 done: A; 2 done: B; hidden by current filters in 2 seconds or at the ne
-- a-file --
x 2026-09-29 A
x 2026-09-29 B
C
D
