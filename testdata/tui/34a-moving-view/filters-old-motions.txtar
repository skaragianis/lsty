size 80 24
start
keys <C-w>5 G k
frame bottom-then-up
bg bottom-then-up-bg
keys kkkkk
frame five-up
bg five-up-bg
keys G <C-u>
frame half-page-up
bg half-page-up-bg
keys gg <C-d>
frame half-page-down
bg half-page-down-bg
keys 3j
frame three-down
bg three-down-bg
keys jjjj
frame four-down
bg four-down-bg
keys G
frame bottom
bg bottom-bg
keys 2gg
frame second
bg second-bg
keys 5k
frame five-up-again
bg five-up-again-bg
keys 9j
frame nine-down
bg nine-down-bg
wheel down 5 18 3
keys j
frame wheel-then-down
bg wheel-then-down-bg
wheel up 5 18 3
keys gg
frame top
bg top-bg
-- config.toml --
show_sidebar = true
show_detail = false
-- todo.txt --
a01 +p01 @c01
a02 +p02 @c02
