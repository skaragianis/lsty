size 60 12
start
keys M
frame middle-of-rows-shown
keys L
frame bottom-of-rows-shown
keys H
frame top
keys v L
frame visual-to-bottom
keys <Esc> G v 2H
frame visual-to-second-row
keys <Esc>
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
a01
a02
a03
a04
a05
