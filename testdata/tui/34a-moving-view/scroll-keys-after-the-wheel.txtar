size 60 10
start
wheel down 10 4 6
frame wheeled
keys H
frame view-top
wheel down 10 4 6
keys <C-e>
frame scroll-from-the-view
wheel down 10 4 6
keys L
frame view-bottom
keys gg
wheel down 10 4 6
keys j
frame j-comes-back
-- config.toml --
show_sidebar = false
show_detail = false
