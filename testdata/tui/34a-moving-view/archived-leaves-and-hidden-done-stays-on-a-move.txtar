size 100 12
start
keys <C-w>5 <Space> <C-w>1 x
keys :
type archive
keys <CR>
keys x
keys u u u
keys <C-r> <C-r> <C-r>
frame before
keys k
frame after
-- config.toml --
show_sidebar = true
show_detail = false
