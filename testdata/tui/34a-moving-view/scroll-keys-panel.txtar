size 80 20
start
keys <Tab> L
frame bottom
keys H
frame top
keys <C-f>
frame page-down
bg page-down-bg
keys <C-e>
frame scroll
bg scroll-bg
keys zz
frame view-keys
bg view-keys-bg
keys zt
frame view-top
bg view-top-bg
keys zb
frame view-bottom
bg view-bottom-bg
-- config.toml --
show_sidebar = true
show_detail = false
-- todo.txt --
a01 +p01
a02 +p02
a03 +p03
a04 +p04
a05 +p05
a06 +p06
a07 +p07
a08 +p08
