size 100 8
start
keys x
write todo.txt next
tick 50ms
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
hidden_tasks = ["later", "archive", "done"]
-- todo.txt --
A
B
-- next --
x 2026-09-29 A edited
B
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1 ✓ A edited                                                                           filtered │
│  2   B                                                                                           │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  1 done: A; hidden by current filters in 2 seconds or at the next key
-- a-file --
x 2026-09-29 A edited
B
