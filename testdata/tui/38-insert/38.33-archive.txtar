size 100 10
start
keys G
keys i
frame a-frame
keys o
type N
keys <CR>
frame b-frame
file todo.txt a-file
file done.txt b-file
-- config.toml --
keep_adding = false
show_sidebar = false
show_detail = false
hidden_items = ["later"]
