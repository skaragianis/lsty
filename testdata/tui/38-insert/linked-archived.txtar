size 100 10
start
keys j j go
frame no-id
file todo.txt no-id-file
keys k gO
frame waiting
keys go
frame with-id
keys New<CR>
file todo.txt with-id-file
-- config.toml --
show_sidebar = false
show_detail = false
hidden_tasks = []
