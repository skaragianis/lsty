size 100 10
start
keys j go
write todo.txt outside
type New
keys <CR>
frame a-frame
file todo.txt a-file
keys <CR>
frame b-frame
file todo.txt b-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
One id:aaaa
Two
Three
-- outside --
One id:aaaa
Three
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  2   One id:aaaa                                                                                 │
│  1   Two                                                                                         │
│    New dep:t001                                                                                  │
│  1   Three                                                                                       │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 INSERT  todo.txt  manual  the task it waits for is gone — delete its dep: to go on           9.9.9
-- a-file --
One id:aaaa
Three
-- b-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  2   One id:aaaa                                                                                 │
│  1   Two                                                                                         │
│    New dep:t001                                                                                  │
│  1   Three                                                                                       │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 INSERT  todo.txt  manual  the task it waits for is gone — delete its dep: to go on           9.9.9
-- b-file --
One id:aaaa
Three
