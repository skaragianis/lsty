size 100 10
start
keys a
type ␣+x
keys <CR>
write todo.txt outside
keys u
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
Buy
B
-- outside --
Buy +x +y
B
-- a-frame --
┌[1]─~/todo.txt────────────────────────────────────────────────────────────────────────────────────┐
│  1   Buy +x +y                                                                                   │
│  1   B                                                                                           │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 N  can't undo: the list changed — look again  sort(manual)  x done  t start  T wont     1|2  9.9.9
-- a-file --
Buy +x +y
B
