size 100 10
start
keys j go
write todo.txt outside
type New
keys <CR>
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
One id:aaaa
Two
Three
-- outside --
One id:aaaa
Two
Three id:t001
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  2   One                                                                                    aaaa │
│  1   Two                                                                                    t002 │
│  3 ⧗ New dep:t002                                                                                │
│  1   Three                                                                                  t001 │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  2 is id:t002; 3 added: New  x done  t state  T stop  o new         9.9.9
-- a-file --
One id:aaaa
Two id:t002
2026-09-29 New dep:t002
Three id:t001
