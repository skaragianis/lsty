size 100 10
start
keys / A <CR>
keys o
type Other
keys <CR>
frame a-frame
cursor a-cursor
type Next
keys <CR>
keys <Esc>
frame b-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A one
B two
C three
