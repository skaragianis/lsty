size 100 10
start
keys / A <CR>
keys o
type Other
keys <CR>
type Next
frame a-frame
keys <CR>
keys <Esc>
frame b-frame
file todo.txt a-file
-- config.toml --
keep_adding = true
show_sidebar = false
show_detail = false
-- todo.txt --
A one
B two
C three
