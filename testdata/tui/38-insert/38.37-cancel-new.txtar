size 100 10
start
keys j o
type N
keys <C-c>
keys u
frame a-frame
keys <CR>
frame b-frame
file todo.txt a-file
-- config.toml --
keep_adding = false
show_sidebar = false
show_detail = false
-- todo.txt --
A
B
