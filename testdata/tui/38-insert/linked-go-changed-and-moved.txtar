size 100 10
start
keys j go
write todo.txt outside
type New
keys <CR>
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
One id:aaaa
Two
Three
-- outside --
Zero
One id:aaaa
Two more
Three
-- a-frame --
