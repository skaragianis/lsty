size 100 10
start
keys o
type N
keys <CR>
write todo.txt outside
keys u
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B
-- outside --
A
2026-09-29 N +y
B
