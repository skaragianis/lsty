size 100 10
start
keys a
type ␣+x
keys <CR>
write todo.txt outside
keys u
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
Buy
B
-- outside --
Buy +x
B +y
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   Buy                                                                                         │
│  1   B +y                                                                                        │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  undid: 1 Buy +x  x done  t state  T stop  o new  a append          9.9.9
-- a-file --
Buy
B +y
