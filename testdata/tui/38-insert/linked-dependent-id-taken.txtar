size 100 10
start
keys j go
write todo.txt outside
type New
keys <CR>
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
One id:aaaa
Two
Three
-- outside --
One id:aaaa
Two
Three id:t001
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  2   One                                                                                    aaaa │
│  1   Two                                                                                    t003 │
│  3 ⧗ New dep:t003                                                                           t004 │
│  1   Three                                                                                  t001 │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  2 is id:t003; 3 added as id:t004: New  x done  t state  T stop     9.9.9
-- a-file --
One id:aaaa
Two id:t003
2026-09-29 New dep:t003 id:t004
Three id:t001
