size 100 10
start
keys gO
type New
keys <C-x>
file todo.txt a-file
frame a-frame
keys j gO <CR>
file todo.txt a-file
frame b-frame
-- config.toml --
show_sidebar = false
show_detail = false
-- keys.toml --
[insert]
cancel = ["<C-x>"]
-- todo.txt --
One id:aaaa
Two
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   One                                                                                    aaaa │
│  1   Two                                                                                         │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  edit discarded — u restores  x done  t state  T stop  o new        9.9.9
-- b-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   One                                                                                    aaaa │
│  2   Two                                                                                         │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  x done  t state  T stop  o new  a append  dd delete  u undo        9.9.9
-- a-file --
One id:aaaa
Two
