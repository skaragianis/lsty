size 100 10
start
keys <Tab> j <CR>
keys <Tab> <Tab> j <CR>
frame a-frame
keys o
frame b-frame
cursor b-cursor
type Call
keys <CR>
frame c-frame
file todo.txt a-file
-- config.toml --
show_detail = false
-- todo.txt --
A +work @phone
B +home
C +work @phone
