size 100 10
start
keys i
type zzz
keys <C-x>
frame a-frame
file todo.txt a-file
keys u
frame b-frame
cursor b-cursor
-- config.toml --
show_sidebar = false
show_detail = false
-- keys.toml --
[insert]
cancel = ["<C-x>"]
-- todo.txt --
Buy
-- a-frame --
┌ [1]─todo.txt ────────────────────────────────────────────────────────────────────────────────────┐
│  1       Buy                                                                                     │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  edit discarded — u restores  x done  t state  o new  a append  dd delete
-- a-file --
Buy
-- b-frame --
┌ [1]─todo.txt ────────────────────────────────────────────────────────────────────────────────────┐
│  1 zzzBuy                                                                                        │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 INSERT  todo.txt  manual  <CR> commit  <C-x> cancel  <C-w> del word  <C-u> del to start
-- b-cursor --
│  1 zzzBuy                                                                                        │
        ^
