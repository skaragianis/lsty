size 100 10
start
keys j go
write todo.txt outside
type New
keys <CR>
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
One id:aaaa
Two
Three
-- outside --
One id:aaaa
Two more
Three
-- a-frame --
┌[1]─"~/todo.txt"──────────────────────────────────────────────────────────────────────────────────┐
│  2   One                                                                                    aaaa │
│  1   Two more                                                                                    │
│  3 New dep:t001                                                                                  │
│  1   Three                                                                                       │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 I  the list changed — <Esc> drops it, or delete the dep:  sort(manual)             3|4│4|12  9.9.9
-- a-file --
One id:aaaa
Two more
Three
