size 100 10
start
keys j go
write todo.txt outside
type New
keys <CR>
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
One id:aaaa
Two
Three
-- outside --
One id:aaaa
Two more
Three
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  2   One                                                                                    aaaa │
│  1   Two                                                                                         │
│    New dep:t001                                                                                  │
│  1   Three                                                                                       │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 INSERT  todo.txt  manual  the list changed — look again; <Esc> drops your edit  <CR> commit  9.9.9
-- a-file --
One id:aaaa
Two more
Three
