size 100 10
start
keys j gO
frame a-frame
fg a-fg
cursor a-cursor
file todo.txt a-file
type New
keys <CR>
frame b-frame
file todo.txt b-file
keys u
frame c-frame
file todo.txt c-file
keys <C-r>
file todo.txt b-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
One id:aaaa
Two
Three
