size 100 10
start
keys i
type zzz
keys <C-x>
keys x
keys u
frame a-frame
file todo.txt a-file
keys u
frame b-frame
-- config.toml --
show_sidebar = false
show_detail = false
-- keys.toml --
[insert]
cancel = ["<C-x>"]
