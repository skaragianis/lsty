size 140 10
start
keys o
type X␣due:soon
keys <CR>
frame f
file todo.txt file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
-- f --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
│  1       A                                                                                                                               │
│    X due:soon                                                                                                                            │
│                                                                                                                                          │
│                                                                                                                                          │
│                                                                                                                                          │
│                                                                                                                                          │
│                                                                                                                                          │
└──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
 INSERT  todo.txt  manual  not a date: soon — today, tomorrow (tom), yesterday; a weekday: monday … sunday, mon … sun; an offset: 3d, +2w, -
-- file --
A
