size 100 10
start
keys j go
type New
keys <End> <C-w>
frame a-frame
keys <CR>
frame b-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
One id:aaaa
Two
Three
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  2   One                                                                                    aaaa │
│  1   Two                                                                                         │
│    New                                                                                           │
│  1   Three                                                                                       │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 INSERT  todo.txt  manual  <CR> commit  <C-w> del word  <C-u> del to start                    9.9.9
-- b-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  2   One                                                                                    aaaa │
│  1   Two                                                                                         │
│  3   New                                                                                    t002 │
│  1   Three                                                                                       │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  3 added as id:t002: New  x done  t state  T stop  o new  a append  9.9.9
