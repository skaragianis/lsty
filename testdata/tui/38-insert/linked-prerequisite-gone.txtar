size 100 10
start
keys j gO
type New
write todo.txt outside
keys <CR>
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
One
Two
Three
-- outside --
One
Three
-- a-frame --
