size 100 12
start
keys v j g t
type +x
keys <CR>
frame a-frame
file todo.txt a-file
keys v j g T
type +x
keys <CR>
frame b-frame
file todo.txt b-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B
C
D
E
-- a-frame --
┌ todo.txt ────────────────────────────────────────────────────────────────────────────────────────┐
│  1       A                                                                                    +x │
│  1       B                                                                                    +x │
│  2       C                                                                                       │
│  3       D                                                                                       │
│  4       E                                                                                       │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  1 tagged +x; 2 tagged +x  x done  t state  o new  a append  dd delete
-- a-file --
A +x
B +x
C
D
E
-- b-frame --
┌ todo.txt ────────────────────────────────────────────────────────────────────────────────────────┐
│  1       A                                                                                       │
│  1       B                                                                                       │
│  2       C                                                                                       │
│  3       D                                                                                       │
│  4       E                                                                                       │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  1 untagged +x; 2 untagged +x  x done  t state  o new  a append  dd delete
-- b-file --
A
B
C
D
E
