size 100 8
start
keys :
type set priority_range=F
keys <CR>
keys g P
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B id:b
C
D
E
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   (F) A                                                                                       │
│  1       B                                                                                     b │
│  2       C                                                                                       │
│  3       D                                                                                       │
│  4       E                                                                                       │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  1 prioritized (F)  x done  t state  T stop  o new  a append        9.9.9
-- a-file --
(F) A
B id:b
C
D
E
