size 100 8
start
keys :
frame a-frame
cursor a-cursor
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B id:b
C
D
E
-- a-frame --
┌ [1]─todo.txt ────────────────────────────────────────────────────────────────────────────────────┐
│  1       A                                                                                       │
│  1       B                                                                                       │
│  2       C                                                                                       │
│  3       D                                                                                       │
│  4       E                                                                                       │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 COMMAND  :  <CR> run  <Tab> next  <Esc> cancel
-- a-cursor --
 COMMAND  :  <CR> run  <Tab> next  <Esc> cancel
           ^
