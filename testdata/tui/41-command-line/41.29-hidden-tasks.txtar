size 100 14
start
frame before
keys :
type set hidden_tasks+=blocked
keys <CR>
frame blocked-hidden
keys :
type set hidden_tasks-=later
keys <CR>
frame later-shown
-- config.toml --
show_detail = false
-- todo.txt --
A id:a
B dep:a
C t:2026-12-01
D
