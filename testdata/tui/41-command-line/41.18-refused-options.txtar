size 100 8
start
keys :
type do 1 --json
keys <CR>
frame f0
keys <C-u>
type do 1 --raw
keys <CR>
frame f1
keys <C-u>
type do 1 --owner x
keys <CR>
frame f2
keys <C-u>
type do 1 --human
keys <CR>
frame f3
keys <C-u>
type do 1 --file f
keys <CR>
frame f4
keys <C-u>
type do 1 --create
keys <CR>
frame f5
keys <C-u>
file todo.txt a-file
