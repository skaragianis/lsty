size 100 8
start
keys :
type del 3
keys <CR>
frame colon-frame
file todo.txt colon-file
start
keys j j d d
frame key-frame
file todo.txt key-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B id:b
C
D
E
-- colon-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1       A                                                                                       │
│  1       B id:b                                                                                  │
│  2       D                                                                                       │
│  3       E                                                                                       │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  3 deleted  x done  t state  o new  a append  dd delete  u undo  / search
-- colon-file --
A
B id:b

D
E
