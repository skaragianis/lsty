size 100 8
start
keys :
type set frob
keys <CR>
frame f0
keys <C-u>
type set upcoming_days=0
keys <CR>
frame f1
keys <C-u>
type set theme=nord
keys <CR>
frame f2
keys <C-u>
type set auto_archive=yes
keys <CR>
frame f3
keys <C-u>
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B id:b
C
D
E
-- f0 --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   A                                                                                           │
│  1   B                                                                                         b │
│  2   C                                                                                           │
│  3   D                                                                                           │
│  4   E                                                                                           │
:set: unknown option "frob"
 COMMAND  :set frob  <CR> run  <Tab> next  <Esc> cancel
-- f1 --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   A                                                                                           │
│  1   B                                                                                         b │
│  2   C                                                                                           │
│  3   D                                                                                           │
│  4   E                                                                                           │
:set: upcoming_days: 0 must be 1 or more
 COMMAND  :set upcoming_days=0  <CR> run  <Tab> next  <Esc> cancel
-- f2 --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   A                                                                                           │
│  1   B                                                                                         b │
│  2   C                                                                                           │
│  3   D                                                                                           │
│  4   E                                                                                           │
:set: theme cannot be set at run time
 COMMAND  :set theme=nord  <CR> run  <Tab> next  <Esc> cancel
-- f3 --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   A                                                                                           │
│  1   B                                                                                         b │
│  2   C                                                                                           │
│  3   D                                                                                           │
│  4   E                                                                                           │
:set: auto_archive: expected bool
 COMMAND  :set auto_archive=yes  <CR> run  <Tab> next  <Esc> cancel
-- a-file --
A
B id:b
C
D
E
