size 100 14
start
keys <Tab> <Tab> <Tab> x
tick 50ms
frame toggled
keys :
type set nu
keys <CR>
write todo.txt next
tick 50ms
frame after-reload
-- config.toml --
hidden_tasks = ["done"]
show_detail = false
