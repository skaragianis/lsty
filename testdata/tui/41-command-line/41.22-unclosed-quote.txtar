size 100 8
start
keys :
type add "open quote
keys <CR>
frame err-frame
keys <Esc>
frame closed-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B id:b
C
D
E
-- err-frame --
┌ todo.txt ────────────────────────────────────────────────────────────────────────────────────────┐
│  1       A                                                                                       │
│  1       B                                                                                       │
│  2       C                                                                                       │
│  3       D                                                                                       │
│  4       E                                                                                       │
unclosed quote
 COMMAND  :add "open quote  Enter run  Tab next  Esc cancel
-- closed-frame --
┌ todo.txt ────────────────────────────────────────────────────────────────────────────────────────┐
│  1       A                                                                                       │
│  1       B                                                                                       │
│  2       C                                                                                       │
│  3       D                                                                                       │
│  4       E                                                                                       │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  x done  t state  o new  a append  dd delete  u undo  / search  ? help
-- a-file --
A
B id:b
C
D
E
