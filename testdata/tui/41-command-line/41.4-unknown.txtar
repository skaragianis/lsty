size 100 8
start
keys :
type quitt!
keys <CR>
frame f0
keys <C-u>
type e other.txt
keys <CR>
frame f1
keys <C-u>
type vs
keys <CR>
frame f2
keys <C-u>
type edit 1
keys <CR>
frame f3
keys <C-u>
type open 1
keys <CR>
frame f4
keys <C-u>
type tui
keys <CR>
frame f5
keys <C-u>
