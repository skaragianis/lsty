size 60 12
start
keys :
type theme
keys <CR>
keys /
type PROBE
frame filtering
cursor filter-cursor
keys <BS><BS><BS><BS><BS>
type probe2
keys <CR>
frame filtered
keys <CR>
frame saved
fg saved-fg
file config.toml config-after
