size 100 8
start
keys :
type set auto_archive
keys <CR>
keys x
frame a-frame
file todo.txt a-todo
file done.txt a-done
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B id:b
C
D
E
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│    ✓ A                                                                                  filtered │
│  2   B id:b                                                                                      │
│  1   C                                                                                           │
│  2   D                                                                                           │
│  3   E                                                                                           │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  1 done: A; archived to done.txt as done:1; hidden by current filters in 2
-- a-todo --

B id:b
C
D
E
-- a-done --
x 2026-09-29 A
