size 100 8
start
keys :
type archive
keys <CR>
frame a-frame
write done.txt outside
keys u
frame b-frame
file todo.txt b-todo
file done.txt b-done
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
x 2026-09-28 A
B

x 2026-09-28 C
D
