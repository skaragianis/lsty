size 130 10
start
frame before
keys :
type set noshow_sidebar
keys <CR>
frame sidebar-off
keys :
type set show_detail
keys <CR>
frame detail-on
-- config.toml --
show_detail = false
-- todo.txt --
A
B id:b
C
D
E
