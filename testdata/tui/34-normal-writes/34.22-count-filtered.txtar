size 100 8
start
keys /
type foo
keys <CR>
keys 2 x
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A foo
H bar
B foo
-- a-frame --
┌ [1]─/foo ────────────────────────────────────────────────────────────────────────────────────────┐
│  1 ✓ A foo                                                                                 today │
│  1 ✓ B foo                                                                                 today │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  1 done: A foo; 3 done: B foo  x done  t state  o new  a append  dd delete
-- a-file --
x 2026-09-29 A foo
H bar
x 2026-09-29 B foo
