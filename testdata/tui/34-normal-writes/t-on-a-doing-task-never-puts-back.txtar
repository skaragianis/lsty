size 100 7
start
keys g t
type +x
keys <CR>
file todo.txt tagged
write todo.txt plain
keys t
frame nothing-to-stop
file todo.txt plain
write todo.txt tagged
keys t
frame an-ordinary-stop
file todo.txt tagged-stopped
