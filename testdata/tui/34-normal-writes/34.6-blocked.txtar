size 100 8
start
keys j
keys t
frame a-frame
fg a-fg
file todo.txt a-file
keys x
frame b-frame
file todo.txt b-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
Write parser id:p
Add CLI dep:p
