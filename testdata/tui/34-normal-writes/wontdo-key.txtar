size 100 9
start
keys T
frame on-todo-moves-on
file todo.txt on-todo-file
keys T
frame on-doing
file todo.txt on-doing-file
keys g g T
frame reopens
file todo.txt reopens-file
keys g g T
keys g g x
frame x-reopens
file todo.txt x-reopens-file
keys g g T
keys g g t
frame t-refused
file todo.txt t-refused-file
keys G
keys T
frame other-done-refused
file todo.txt other-done-file
keys u
frame undo-is-the-last-write
