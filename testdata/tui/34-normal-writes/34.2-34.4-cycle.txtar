size 100 8
start
keys t
frame a-frame
file todo.txt a-file
keys t
frame b-frame
file todo.txt b-file
keys t
frame c-frame
file todo.txt c-file
keys T
frame d-frame
file todo.txt d-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
(A) Call client +work
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1 ▶ (A) Call client +work                                                                    0m │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  ▶ 1 in doing  1 started  x done  t state  T stop  o new  a append
-- a-file --
(A) Call client +work started:2026-09-29T0900Z
-- b-frame --
