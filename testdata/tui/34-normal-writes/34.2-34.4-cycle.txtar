size 100 8
start
keys t
frame a-frame
file todo.txt a-file
keys t
frame b-frame
file todo.txt b-file
keys t
frame c-frame
file todo.txt c-file
keys T
frame d-frame
file todo.txt d-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
(A) Call client +work
