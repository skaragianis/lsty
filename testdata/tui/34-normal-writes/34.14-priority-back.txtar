size 100 8
start
keys g P
frame a-frame
file todo.txt a-file
keys j
keys g P
frame b-frame
file todo.txt b-file
-- config.toml --
show_sidebar = false
show_detail = false
priority_range = "C"
-- todo.txt --
Buy
(A) Buy
