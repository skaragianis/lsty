size 100 7
start
keys v j t
file todo.txt both-stopped
keys t
frame selection-then-t
file todo.txt first-new-claim
keys u
file todo.txt both-stopped
keys u
frame undo-brings-both-back
file todo.txt claim-file
keys v j t
file todo.txt both-stopped
keys v j t
frame selection-then-selection
file todo.txt both-new-claims
keys u u
file todo.txt claim-file
keys 2 t
file todo.txt both-stopped
keys 2 t
frame count-then-count
file todo.txt claim-file
keys u
frame undo-of-one-press
file todo.txt both-stopped
keys u
file todo.txt claim-file
keys t 1 t
frame t-then-count-of-one
file todo.txt claim-file
keys u u
keys t 2 t
frame t-then-count-of-two
file todo.txt t-then-count-of-two-file
