size 100 7
start
keys t
write todo.txt task-changed
event
tick 50ms
keys t
frame task-changed-and-seen
file todo.txt task-changed
keys t
file todo.txt task-changed
tick 2s
keys t
file todo.txt task-changed-then-started
write todo.txt todo.txt
event
tick 50ms
keys t
write todo.txt task-changed
keys t
frame task-changed-not-seen
file todo.txt task-changed
write todo.txt todo.txt
event
tick 2s
keys t
write todo.txt line-above
event
tick 50ms
keys t
frame only-another-line-changed
file todo.txt line-above-put-back
