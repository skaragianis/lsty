size 100 8
start
keys g p
frame a-frame
file todo.txt a-file
keys g p
frame b-frame
file todo.txt b-file
keys g p
frame c-frame
file todo.txt c-file
keys g p
frame d-frame
file todo.txt d-file
-- config.toml --
show_sidebar = false
show_detail = false
priority_range = "C"
