size 100 10
start
keys j t
frame done-refused
keys j t
frame wontdo-refused
keys k 2 t
frame count-refused
keys V j t
frame selection-refused
keys <Esc> g g V j t
frame mixed-refused
file todo.txt untouched-file
keys <Esc> u
frame nothing-to-undo
keys g g t j .
frame repeat-refused
file todo.txt started-file
-- config.toml --
show_sidebar = false
show_detail = false
