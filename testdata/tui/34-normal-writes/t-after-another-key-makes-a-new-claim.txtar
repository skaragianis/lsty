size 100 7
start
keys t j k t
file todo.txt new-claim
keys u u
keys t <Esc> t
file todo.txt new-claim
keys u u
keys t <F9> t
file todo.txt new-claim
keys u u
keys t 1 <Esc> t
file todo.txt new-claim
keys u u
keys t .
frame repeat
file todo.txt new-claim
keys u u
keys S t
frame after-the-stop-key
file todo.txt new-claim
