size 100 8
start
keys t
frame a-frame
file todo.txt a-file
keys t
frame b-frame
file todo.txt b-file
keys t x
frame c-frame
file todo.txt c-file
keys x
frame d-frame
file todo.txt d-file
keys t
frame e-frame
file todo.txt e-file
-- config.toml --
show_sidebar = false
show_detail = false
