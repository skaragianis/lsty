size 130 30
start
keys <Tab>
frame before
clickon "B"
keys j
frame frame
bg frame-bg
-- config.toml --
show_detail = false
-- todo.txt --
A +work @phone
B +home file:notes.md
C +work.acme
D
E
F started:2026-09-29T0900Z
