size 130 30
start
keys / i n v <CR>
clickon "+work"
clickon "@phone"
frame all
clickon "+work"
frame no-project
clickon "@phone"
frame no-context
clickon "Today"
frame no-filter
clickon "/inv"
frame frame
bg frame-bg
-- config.toml --
show_sidebar = false
show_detail = false
start_filter = "Today"
-- todo.txt --
A inv +work @phone due:2026-09-29
B +home
C +work.acme
