size 100 10
start
clipboard set s-clip
lock hold
keys p
frame a-frame
file todo.txt a-file
lock release
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
-- s-clip --
Buy
-- a-frame --
