size 100 10
start
keys d d j p
write todo.txt s-edit
tick 100ms
keys u
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A id:a
B dep:a
C
-- s-edit --

B dep:a +z
C
A id:a
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  2 ⧗ B dep:a +z                                                                                  │
│  1   C                                                                                           │
│  4   A                                                                                         a │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  can't undo: the list changed — look again  todo.txt  manual  x done  t start         9.9.9
-- a-file --

B dep:a +z
C
A id:a
