size 100 8
start
keys g T
type id:a
keys <CR>
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A id:a
B dep:a
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   A                                                                                           │
│  1   B                                                                                           │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  1 untagged id:a; unblocked 2  x done  t state  T stop  o new       9.9.9
-- a-file --
A
B
