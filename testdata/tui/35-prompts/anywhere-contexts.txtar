size 100 8
start
keys g t
type @mai
keys <Tab>
frame a-frame
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A +home @phone
B +work
C +work.acme @email
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   A +home @phone                                                                              │
│  1   B +work                                                                                     │
│  2   C +work.acme @email                                                                         │
│                                                                                                  │
│                                                                                                  │
@email
 COMMAND  tag: @email  <CR> run  <Tab> next  <Esc> cancel
