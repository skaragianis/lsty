size 100 8
start
keys 2 g d
write todo.txt after
tick 1s
type fri
keys <CR>
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B
C
-- after --
B
C
-- a-frame --
┌[1]─~/todo.txt────────────────────────────────────────────────────────────────────────────────────┐
│  1   B                                                                                           │
│  1   C                                                                                           │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 N  the list changed — look again  sort(manual)  x done  t start  T wont  o new          1|2  9.9.9
-- a-file --
B
C
