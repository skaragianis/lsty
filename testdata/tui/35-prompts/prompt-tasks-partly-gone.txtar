size 100 8
start
keys 2 g d
write todo.txt after
tick 1s
type fri
keys <CR>
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B
C
-- after --
B
C
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   B                                                                                       fri │
│  1   C                                                                                           │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  1 due 2026-10-02  x done  t state  T stop  o new  a append         9.9.9
-- a-file --
B due:2026-10-02
C
