size 100 8
start
keys s k g t
type dep:a
keys <CR>
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
(B) A id:a dep:b
(A) B id:b
-- a-frame --
┌[1]─"~/todo.txt"──────────────────────────────────────────────────────────────────────────────────┐
│  1   (A) B                                                                                     b │
│  1 ⧗ (B) A dep:b                                                                               a │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
1 → 2 → 1 would be a dependency cycle
 C  tag: dep:a  <CR> add  <Tab> next  <Esc> cancel
-- a-file --
(B) A id:a dep:b
(A) B id:b
