size 100 8
start
keys j g t
type dep:a
keys <CR>
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A id:a dep:b
B id:b
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1 ⧗ A id:a dep:b                                                                                │
│  2   B id:b                                                                                      │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
2 → 1 → 2 would be a dependency cycle
 COMMAND  tag: dep:a  <CR> run  <Tab> next  <Esc> cancel
-- a-file --
A id:a dep:b
B id:b
