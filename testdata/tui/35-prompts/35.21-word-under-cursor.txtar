size 100 8
start
keys g t
type +work +h
keys <Tab>
frame a-frame
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A +home @phone
B +work
C +work.acme @email
-- a-frame --
┌ todo.txt ────────────────────────────────────────────────────────────────────────────────────────┐
│  1       A                                                                     +home @phone      │
│  1       B                                                                     +work             │
│  2       C                                                                     +work.acme @email │
│                                                                                                  │
│                                                                                                  │
+home
 COMMAND  tag: +work +home  Enter run  Tab next  Esc cancel
