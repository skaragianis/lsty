size 100 8
start
keys g d
write todo.txt after
tick 1s
type fri
keys <CR>
frame a-frame
file todo.txt a-file
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A
B
-- after --
B
-- a-frame --
┌ [1]─~/todo.txt ──────────────────────────────────────────────────────────────────────────────────┐
│  1   B                                                                                           │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
│                                                                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────────┘
 NORMAL  the list changed — look again  todo.txt  manual  x done  t start  T wont  o new      9.9.9
-- a-file --
B
