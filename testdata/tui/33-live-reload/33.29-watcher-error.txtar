size 100 10
start
event error watch limit reached
frame error
write todo.txt next
tick 30s
frame stale
tick 30s
frame polled
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A +p
B +p
C +p
D +p
E +p
-- next --
A +p
B +p
C +p
D +p
E +p
N +p
