size 100 18
start
keys <C-w>5 j j j x
tick 50ms
frame before
write done.txt next
tick 50ms
frame after
-- todo.txt --
A +p
B +p
C +p
D +p
E +p
-- done.txt --
x 2026-09-01 Old +p
-- next --
x 2026-09-01 Old +p
x 2026-09-02 Older +p
