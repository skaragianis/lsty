size 50 10
start
keys G
write todo.txt next
tick 50ms
frame after
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A +p
B +p
C +p
D +p
E +p
-- next --
A +p
B +p
C +p
D +p
-- after --
┌ [1]─~/todo.txt ────────────────────────────────┐
│  3       A                                  +p │
│  2       B                                  +p │
│  1       C                                  +p │
│  4       D                                  +p │
│                                                │
│                                                │
│                                                │
└────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  x done  t state  o new
