size 50 10
start
keys j j
write todo.txt next
tick 50ms
frame after
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A +p
B +p
C +p
D +p
E +p
-- next --
C +p
A +p
B +p
D +p
E +p
-- after --
┌ [1]─~/todo.txt ────────────────────────────────┐
│  2   C +p                                      │
│  1   A +p                                      │
│  3   B +p                                      │
│  1   D +p                                      │
│  2   E +p                                      │
│                                                │
│                                                │
└────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  x done  t start  9.9.9
