size 60 10
start sub/todo.txt
remove sub
tick 50ms
frame deleted
write sub/todo.txt recloned
tick 1m
frame back
write sub/todo.txt edited
tick 50ms
frame later
-- config.toml --
show_sidebar = false
show_detail = false
-- sub/todo.txt --
A +p
B +p
-- recloned --
C +p
D +p
-- edited --
C +p
D +p
E +p
-- deleted --
