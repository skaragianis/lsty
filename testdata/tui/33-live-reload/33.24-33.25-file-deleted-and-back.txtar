size 60 10
start
remove todo.txt
tick 50ms
frame deleted
write todo.txt restored
tick 50ms
frame back
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
A +p
B +p
C +p
D +p
E +p
-- restored --
C +p
D +p
