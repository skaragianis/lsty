# a list that fitted the pane and grows past it follows the new rows
size 40 12
start
keys j
frame before
write todo.txt next
tick 50ms
frame after
-- config.toml --
show_sidebar = false
show_detail = false
-- todo.txt --
Task001 +p
Task002 +p
Task003 +p
Task004 +p
Task005 +p
Task006 +p
Task007 +p
Task008 +p
-- next --
Task001 +p
Task002 +p
Task003 +p
Task004 +p
Task005 +p
Task006 +p
Task007 +p
Task008 +p
New01 +p
New02 +p
New03 +p
New04 +p
New05 +p
New06 +p
-- before --
┌ [1]─~/todo.txt ──────────────────────┐
│  1   Task001 +p                      │
│  2   Task002 +p                      │
│  1   Task003 +p                      │
│  2   Task004 +p                      │
│  3   Task005 +p                      │
│  4   Task006 +p                      │
│  5   Task007 +p                      │
│  6   Task008 +p                      │
│                                      │
└──────────────────────────────────────┘
 NORMAL  todo.txt  manual  x done
-- after --
┌ [1]─~/todo.txt ──────────────────────┐
│  2   Task002 +p                      │
│  1   Task003 +p                      │
│  2   Task004 +p                      │
│  3   Task005 +p                      │
│  4   Task006 +p                      │
│  5   Task007 +p                      │
│  6   Task008 +p                      │
│  7   New01 +p                        │
│  8   New02 +p                        │
└──────────────────────────────────────┘
 NORMAL  todo.txt  manual  x done
