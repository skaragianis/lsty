size 60 10
start sub/todo.txt
remove sub
write sub/todo.txt recloned
tick 50ms
frame back
write sub/todo.txt edited
tick 50ms
frame later
-- config.toml --
show_sidebar = false
show_detail = false
-- sub/todo.txt --
A +p
B +p
-- recloned --
C +p
D +p
-- edited --
C +p
D +p
E +p
-- back --
┌ [1]─todo.txt ────────────────────────────────────────────┐
│  1       C                                            +p │
│  1       D                                            +p │
│                                                          │
│                                                          │
│                                                          │
│                                                          │
│                                                          │
└──────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  x done  t state  o new  a append
-- later --
┌ [1]─todo.txt ────────────────────────────────────────────┐
│  1       C                                            +p │
│  1       D                                            +p │
│  2       E                                            +p │
│                                                          │
│                                                          │
│                                                          │
│                                                          │
└──────────────────────────────────────────────────────────┘
 NORMAL  todo.txt  manual  x done  t state  o new  a append
