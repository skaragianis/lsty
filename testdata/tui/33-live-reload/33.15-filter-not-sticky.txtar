size 100 12
start
keys <C-w>3 x <CR>
keys j j
frame before
write todo.txt next
tick 50ms
frame after
-- todo.txt --
A +x
B +x
C +x
D +x
E +x
-- next --
A +x
B +x
C +y
D +x
E +x
